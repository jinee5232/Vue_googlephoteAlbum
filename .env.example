# 複製成 .env 並填入值（這些都只在 server 使用，不會進到前端）

# Flickr API Key / Secret：https://www.flickr.com/services/apps/create/
FLICKR_API_KEY=
FLICKR_API_SECRET=

# 執行 npm run flickr-auth 後取得
FLICKR_OAUTH_TOKEN=
FLICKR_OAUTH_TOKEN_SECRET=
FLICKR_USER_ID=

# 可以管理相簿（上傳、建立 / 刪除）的 Google 帳號，多個用逗號分隔
EDITOR_EMAILS=
# 只能瀏覽的 Google 帳號，多個用逗號分隔
VIEWER_EMAILS=
